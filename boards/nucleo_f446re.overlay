#include <zephyr/dt-bindings/display/panel.h>

/*
 * MG90S servo:
 *   Signal -> D9 = PC7 = TIM3_CH2, 50 Hz PWM (20 ms period)
 *   Power  -> 5 V (preferably an external supply), GND shared with the board
 *
 * US-100 (Y401) ultrasonic module in UART mode (jumper fitted on the back):
 *   Trig/TX -> D8 = PA9  (USART1 TX)
 *   Echo/RX -> D2 = PA10 (USART1 RX)
 *   VCC     -> 3.3 V, GND -> GND
 *   9600 baud, 8N1
 *
 * GC9A01 1.28" round IPS, 240x240, 8-pin SPI module:
 *   SCL -> D13 = PA5 (SPI1 SCK)  - also drives the on-board LD2 LED,
 *                                  so LD2 flickers during screen updates
 *   SDA -> D11 = PA7 (SPI1 MOSI)
 *   CS  -> D4  = PB5
 *   DC  -> D7  = PA8
 *   RES -> D6  = PB10
 *   BLK -> 3.3 V (backlight always on)
 *   VCC -> 3.3 V, GND -> GND
 *
 * Alarm outputs:
 *   Passive buzzer module I/O -> D10 = PB6 = TIM4_CH1, 3 kHz PWM
 *     (VCC -> 3.3 V, GND -> GND). D10 is the usual Arduino SPI
 *     chip-select pin, which is why the display CS is moved to D4.
 *   Red LED -> D5 = PB4, through a 220-330 ohm series resistor,
 *     cathode to GND, active-high
 *
 * NOTE: pinctrl labels follow Zephyr's usual naming pattern. If
 * `west build` reports one as undeclared, look up the exact name in
 * your workspace's STM32F4 pinctrl files and update it here.
 */
/ {
	aliases {
		servo = &servo0;
		us100-uart = &usart1;
		buzzer-pwm = &buzzer_pwm;
		led-alarm = &alarm_led;
	};

	chosen {
		zephyr,display = &gc9a01;
	};

	servos {
		/* Reusing the generic "PWM output" binding for the servo,
		 * same idea as the buzzer in the traffic light project.
		 */
		compatible = "pwm-leds";

		servo0: servo_0 {
			pwms = <&pwm3 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	pwmleds {
		/* Not an LED - generic PWM output for the passive buzzer,
		 * same node as in the traffic light project so buzzer.c
		 * can be reused unchanged.
		 */
		compatible = "pwm-leds";

		buzzer_pwm: buzzer_pwm {
			pwms = <&pwm4 1 PWM_HZ(3000) PWM_POLARITY_NORMAL>;
		};
	};

	leds {
		compatible = "gpio-leds";

		alarm_led: led_alarm {
			gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
			label = "Red alarm LED";
		};
	};

	gc9a01_mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi1>;
		dc-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpiob 10 GPIO_ACTIVE_LOW>;
		write-only; /* no MISO wire on this module */
		#address-cells = <1>;
		#size-cells = <0>;

		gc9a01: gc9a01@0 {
			compatible = "galaxycore,gc9x01x";
			reg = <0>; /* first entry of spi1 cs-gpios */
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			/* Conservative for dupont wires; try raising once it works */
			mipi-max-frequency = <DT_FREQ_M(20)>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			width = <240>;
			height = <240>;
			/* IPS panels usually need this, otherwise colours come out inverted */
			display-inversion;
			/* Rotated in the panel controller itself, so it costs no CPU time */
			orientation = "180";
		};
	};
};

/*
 * TIM3 is a 16-bit timer. Without a prescaler, a 20 ms period at the
 * timer clock needs far more than 65535 counts, so divide the clock
 * down to roughly 1 MHz (1 count ~ 1 us).
 */
&timers3 {
	status = "okay";
	st,prescaler = <83>;

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pc7>;
		pinctrl-names = "default";
	};
};

/*
 * TIM4 for the buzzer. At 3 kHz the period fits in 16 bits without a
 * prescaler. Kept separate from TIM3 (servo, 50 Hz): channels on the
 * same timer share one frequency.
 */
&timers4 {
	status = "okay";
	st,prescaler = <0>;

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6>;
		pinctrl-names = "default";
	};
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

/* Override the board default so CS is PB5, not PB6 (D10) */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
	status = "okay";
};

/*
 * The Nucleo-F446RE board file routes PA5 (the LD2 LED) to TIM2_CH1 as
 * a PWM LED (node pwm2). PA5 is SPI1 SCK here. With CONFIG_PWM=y that
 * PWM driver would take PA5 over at boot and the display would never
 * receive a clock. Disabling only the parent timers2 is not enough -
 * the pwm2 child node must be disabled itself.
 */
&timers2 {
	status = "disabled";
};

&pwm2 {
	status = "disabled";
};
